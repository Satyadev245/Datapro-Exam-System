# Frontend (Netlify or same-origin if served by backend)
VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api

# Backend
NODE_ENV=production
PORT=10000
APP_URL=https://datapro-exam-system.netlify.app
CORS_ORIGINS=https://datapro-exam-system.netlify.app
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# PostgreSQL (Render / Neon / Supabase)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_POOL_MAX=10

# File storage
DATA_DIR=./data
UPLOADS_DIR=./data/uploads/examinations
ATTENDANCE_UPLOADS_DIR=./data/uploads/attendance

# Optional AI
GEMINI_API_KEY=
